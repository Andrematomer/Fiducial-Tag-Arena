{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fiducial Tag Arena",
  "version": "0.1.0",
  "identifier": "io.github.andrematomer.fiducialtagarena",
  "build": {
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fiducial Tag Arena",
        "width": 1600,
        "height": 1000,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../detectors/": "detectors/"
    }
  }
}
